{
  "name": "@pokerhawk/tournament-math",
  "version": "0.1.0",
  "description": "Pure poker tournament math: ICM equity, payout curves, table balancing, and close-table seat planning. Zero dependencies.",
  "keywords": [
    "poker",
    "tournament",
    "icm",
    "independent-chip-model",
    "payouts",
    "prize-pool",
    "table-balancing",
    "malmuth-harville",
    "m-ratio"
  ],
  "homepage": "https://github.com/TourneyTek-Inc/tournament-math#readme",
  "bugs": "https://github.com/TourneyTek-Inc/tournament-math/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TourneyTek-Inc/tournament-math.git"
  },
  "license": "MIT",
  "author": "Tyler Henson <tyler.henson@tourneytek.com> (https://www.pokerhawk.io)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
